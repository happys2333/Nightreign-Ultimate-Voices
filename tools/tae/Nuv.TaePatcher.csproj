<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SoulsFormatsProject Condition="'$(SoulsFormatsProject)' == ''">$(MSBuildThisFileDirectory)..\..\.tools\soulsformats\SoulsFormats\SoulsFormats.csproj</SoulsFormatsProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="$(SoulsFormatsProject)" />
  </ItemGroup>
</Project>
